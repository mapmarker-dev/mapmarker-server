# 이 파일을 .env로 복사해서 쓴다. .env는 커밋하지 않는다.
# 아래 값은 로컬 Docker용 예시다. 운영 값은 여기에 적지 않는다.

# 서버
PORT=3000
# development | test | production. production이면 Swagger(/docs)를 열지 않는다.
NODE_ENV=development

# 로컬 PostgreSQL (docker compose)
POSTGRES_USER=mapmarker
POSTGRES_PASSWORD=set-me
POSTGRES_DB=mapmarker
POSTGRES_PORT=5432

# 서버와 Prisma CLI가 쓰는 DB 주소
DATABASE_URL=postgresql://mapmarker:set-me@localhost:5432/mapmarker

# e2e 테스트 DB. 테스트를 돌릴 때마다 지우고 다시 만든다.
# DB 이름이 _test로 끝나지 않으면 e2e가 실행을 멈춘다(개발 DB를 지우지 않게).
TEST_DATABASE_URL=postgresql://mapmarker:set-me@localhost:5432/mapmarker_test
